{
  "name": "checkevent-backend",
  "version": "1.0.0",
  "description": "Backend API CheckEvent - Proyecto Integrador UCEVA",
  "main": "index.js",
  "scripts": {
    "start": "tsnd --respawn --clear src/app.ts",
    "db:init": "tsnd --transpile-only src/scripts/init-db.ts",
    "db:seed": "tsnd --transpile-only src/scripts/seed-db.ts",
    "db:fix-passwords": "tsnd --transpile-only src/scripts/fix-passwords.ts"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "17.2.3",
    "env-var": "7.5.0",
    "express": "5.2.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/pg": "^8.23.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "ts-node-dev": "2.0.0",
    "typescript": "5.9.3"
  }
}